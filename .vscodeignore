# VSCE gives all !patterns priority over exclusions, regardless of line order.
# Keep includes shallow so nested .private/, logs and workspace files cannot match.
**
!package.json
!README.md
!README_CN.md
!CHANGELOG.md
!LICENSE
!out/*.js
!out/utils/*.js
!webview/diffs-bundle.js
!webview/watchExcludePanel.js
!resources/*.svg
!resources/*.png
!node_modules/ignore/*.js
!node_modules/ignore/package.json
!node_modules/ignore/LICENSE-MIT
!node_modules/ignore/README.md
!node_modules/diff/package.json
!node_modules/diff/LICENSE
!node_modules/diff/README.md
!node_modules/diff/libcjs/package.json
!node_modules/diff/libcjs/*.js
!node_modules/diff/libcjs/diff/*.js
!node_modules/diff/libcjs/convert/*.js
!node_modules/diff/libcjs/patch/*.js
!node_modules/diff/libcjs/util/*.js
